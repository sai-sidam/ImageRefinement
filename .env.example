# Google AI Studio (get key from https://aistudio.google.com/apikey)
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key

# Shopify (Admin API access token from your app or custom app)
# Use your store hostname, e.g. yourstore.myshopify.com (not the admin.shopify.com URL)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx
